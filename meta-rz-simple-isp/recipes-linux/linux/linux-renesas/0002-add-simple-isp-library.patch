+		return ret;
+
+	ispOpenInfo.gain = v4l2_ctrl_find(ov_subdev->ctrl_handler,V4L2_CID_GAIN);
+	ispOpenInfo.expose = v4l2_ctrl_find(ov_subdev->ctrl_handler,V4L2_CID_EXPOSURE);
