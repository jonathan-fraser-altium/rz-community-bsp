+int isp_ctrl_streamon(ioctl_streamon func, struct file *file, void *fh, enum v4l2_buf_type type)
+{
+	/* ISP MOD-K START */
+//	unsigned char gain_p; 
+//	unsigned char expose_p;
+	int gain_p; 
