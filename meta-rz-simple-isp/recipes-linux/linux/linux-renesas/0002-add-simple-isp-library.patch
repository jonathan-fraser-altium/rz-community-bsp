+			return -EINVAL;
+		}
+		changeFmt.format.code = changeInFmtToBusFmt[getInFmt];
+	}else{
+		changeFmt.format.code = changeInFmtToBusFmt[ispOpenInfo.inFMT];
+	}
+	setINFMTFlag = 0;
+	ret = isp_ctrl_set_format(file);
