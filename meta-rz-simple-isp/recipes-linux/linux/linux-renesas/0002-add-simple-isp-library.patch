+	ispRunState = ISP_CTRL_RUN;
+	cam_image_physadr_got = 0;
+	get_camera_physadr_idx = 0;
+	num_camera_images = 0;
+
+	drpLevel = ISP_CTRL_DRP_LEVEL_DEF_VAL;
