+	ispOpenInfo.expose = NULL;
+	ispOpenInfo.td = NULL;
+	ispOpenInfo.td2 = NULL;
+
+	// for AE
+	setAE.ae_on = 0;
+	setAE.expose_level = 0;
+	setAE.target_y = 0;
+	setAE.threshold = 0;
+	waitCallback = 0;
+
+	wakeup_list_lock = __SPIN_LOCK_UNLOCKED(wakeup_list_lock);
+    INIT_LIST_HEAD(&wakeup_entry_head.list);
