+		//[I2C] set shutter speed
+		if(ispOpenInfo.expose)
+		{
+			isp_ctrl_dprintk("[info]%s ov5645_set expose=%d\n",__func__,expose_p);
+			v4l2_ctrl_s_ctrl(ispOpenInfo.expose,expose_p);
+		}
+	}
+	/* ISP MOD-K END   */
+
+	return func(file, fh, type);
+}
